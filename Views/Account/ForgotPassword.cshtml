@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Recuperar contraseña"; ViewData["AuthPage"] = true; }

<div class="auth-card">
    <h1>¿Olvidaste tu contraseña?</h1>
    <p class="muted">Escribe tu correo y te enviaremos un enlace para crear una nueva. El enlace sirve una vez durante 1 hora.</p>

    @if (TempData["DevResetLink"] is string devLink)
    {
        <div class="dev-box" role="status">
            <strong>Modo desarrollo:</strong> el correo no está configurado, así que aquí está el enlace para probar:
            <a class="btn soft small" href="@devLink">Crear nueva contraseña</a>
        </div>
    }

    <form asp-action="ForgotPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="error" role="alert"></div>
        <label asp-for="Email">Correo</label>
        <input asp-for="Email" type="email" autocomplete="email" required />
        <span asp-validation-for="Email" class="field-error"></span>
        <button class="btn primary full" type="submit">Enviar enlace</button>
    </form>

    <div class="auth-alt">
        <a class="btn full outline" asp-action="Login">← Volver a iniciar sesión</a>
    </div>
</div>
