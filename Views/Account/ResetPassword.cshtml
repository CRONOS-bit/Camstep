@model ResetPasswordViewModel
@{ ViewData["Title"] = "Nueva contraseña"; ViewData["AuthPage"] = true; }

<div class="auth-card">
    <h1>Crea una nueva contraseña</h1>

    <form asp-action="ResetPassword" method="post">
        <input asp-for="Token" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="error" role="alert"></div>

        <label asp-for="NewPassword">Nueva contraseña</label>
        <input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="6" required />
        <span asp-validation-for="NewPassword" class="field-error"></span>

        <label asp-for="ConfirmPassword">Confirmar contraseña</label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>

        <button class="btn primary full" type="submit">Guardar contraseña</button>
    </form>
</div>
