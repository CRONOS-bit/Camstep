@model int
<svg class="plant stage-@Model" viewBox="0 0 100 100" aria-hidden="true">
    <ellipse cx="50" cy="90" rx="30" ry="6" class="plant-soil" />
    @if (Model == 0)
    {
        <ellipse cx="50" cy="84" rx="6" ry="4.5" class="plant-seed" />
    }
    @if (Model >= 1)
    {
        var top = Model switch { 1 => 70, 2 => 60, 3 => 52, _ => 46 };
        <path d="M50 88 L50 @top" class="plant-stem" style="stroke-width: @(Model >= 4 ? 6 : Model == 3 ? 4 : 3)" />
    }
    @if (Model == 1)
    {
        <path d="M50 72 C49 64 54 58 61 56 C61 63 57 69 50 72 Z" class="plant-leaf" />
        <path d="M50 72 C48 66 44 63 39 62 C40 67 44 71 50 72 Z" class="plant-leaf light" />
    }
    @if (Model == 2)
    {
        <path d="M50 64 C49 54 56 46 66 44 C66 53 60 61 50 64 Z" class="plant-leaf" />
        <path d="M50 70 C47 62 40 58 33 58 C34 65 41 70 50 70 Z" class="plant-leaf light" />
        <path d="M50 78 C53 72 59 70 64 71 C62 76 56 79 50 78 Z" class="plant-leaf" />
    }
    @if (Model == 3)
    {
        <circle cx="50" cy="44" r="18" class="plant-leaf" />
        <circle cx="36" cy="54" r="13" class="plant-leaf light" />
        <circle cx="64" cy="54" r="13" class="plant-leaf light" />
    }
    @if (Model >= 4)
    {
        <circle cx="50" cy="32" r="22" class="plant-leaf" />
        <circle cx="31" cy="44" r="16" class="plant-leaf light" />
        <circle cx="69" cy="44" r="16" class="plant-leaf light" />
        <circle cx="50" cy="50" r="14" class="plant-leaf" />
    }
    @if (Model == 5)
    {
        <circle cx="40" cy="26" r="3.6" class="plant-flower" />
        <circle cx="61" cy="30" r="3.6" class="plant-flower" />
        <circle cx="30" cy="44" r="3.2" class="plant-flower" />
        <circle cx="68" cy="47" r="3.2" class="plant-flower" />
        <circle cx="52" cy="44" r="3" class="plant-flower" />
    }
</svg>
