@model TaskItem
@{
    var isEdit = Model.Id > 0;
    var returnUrl = ViewBag.ReturnUrl as string;
}

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
    <div asp-validation-summary="ModelOnly" class="error" role="alert"></div>

    @if (isEdit)
    {
        <input asp-for="Id" type="hidden" />
    }
    <input type="hidden" name="returnUrl" value="@returnUrl" />

    <label asp-for="Title">Título</label>
    <input asp-for="Title" maxlength="120" required />
    <span asp-validation-for="Title" class="field-error"></span>

    <label asp-for="Description">Descripción <small class="muted">(opcional)</small></label>
    <textarea asp-for="Description" maxlength="1000" rows="3"></textarea>
    <span asp-validation-for="Description" class="field-error"></span>

    <div class="form-row">
        <div>
            <label asp-for="DueDate">Fecha límite</label>
            <input asp-for="DueDate" type="date" min="2000-01-01" max="2100-12-31" required />
            <span asp-validation-for="DueDate" class="field-error"></span>
        </div>
        <div>
            <label asp-for="Priority">Prioridad</label>
            <select asp-for="Priority">
                @foreach (var p in Priorities.All)
                {
                    <option value="@p" selected="@(Model.Priority == p)">@p</option>
                }
            </select>
            <span asp-validation-for="Priority" class="field-error"></span>
        </div>
    </div>

    @if (isEdit)
    {
        <label class="inline"><input asp-for="IsCompleted" type="checkbox" /> Completada</label>
    }

    <div class="form-actions">
        <button class="btn primary" type="submit">@(isEdit ? "Guardar cambios" : "Guardar")</button>
        <a class="btn" href="@(!string.IsNullOrEmpty(returnUrl) && Url.IsLocalUrl(returnUrl) ? returnUrl : Url.Action("Index"))">Cancelar</a>
    </div>
</form>
